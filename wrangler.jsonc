{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "upload_source_maps": true,
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker runs on every request so it can add headers (noindex on previews).
    "run_worker_first": true,
  },
  "vars": {
    "ENVIRONMENT": "production",
  },
  // Results store. IDs are not secrets. Previews share a separate database so they never touch production data.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-results",
      "database_id": "d6011246-9a5a-4d5d-8c08-06ea24322814",
      "migrations_dir": "migrations",
    },
  ],
  // Settings used by `wrangler preview` deployments (one per pull request).
  "previews": {
    "vars": {
      "ENVIRONMENT": "preview",
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "portfolio-results-preview",
        "database_id": "6d8f72cd-7c80-4a25-a02b-c1cb3cd49306",
        "migrations_dir": "migrations",
      },
    ],
  },
  "observability": {
    "enabled": true,
  },
}
